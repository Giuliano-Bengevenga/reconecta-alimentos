<%- include('../partials/head',{title:'Perfil do estabelecimento'}) %>
<main class="container narrow"><section class="panel"><h1>Perfil do estabelecimento</h1><%if(error){%><p class="error"><%=error%></p><%}%><form method="post" action="/estabelecimento/perfil"><input type="hidden" name="csrfToken" value="<%=csrfToken%>"><label>Nome do estabelecimento<input name="institutionName" value="<%=institution.name%>" required></label><div class="form-grid"><label>Cidade<input name="city" value="<%=institution.city%>" required></label><label>Bairro<input name="neighborhood" value="<%=institution.neighborhood%>" required></label></div><label>Endereço de retirada<input name="address" value="<%=institution.address%>" required></label><label>Telefone<input name="phone" value="<%=institution.phone%>" required></label><label>Responsável<input name="responsible" value="<%=institution.responsible%>" required></label><button class="button">Salvar perfil</button></form></section></main>
<%- include('../partials/footer') %>
