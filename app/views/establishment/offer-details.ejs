<%- include('../partials/head',{title:offer.name}) %>
<main class="container page"><div class="page-heading"><div><span class="eyebrow">Detalhes da oferta</span><h1><%=offer.name%></h1></div><%if(offer.status==='Disponível'){%><a class="button secondary" href="/estabelecimento/ofertas/<%=offer.id%>/editar">Editar oferta</a><%}%></div>
<section class="panel"><p><%=offer.description%></p><div class="detail-grid"><p><strong>Quantidade</strong><br><%=offer.quantity%> <%=offer.unit%></p><p><strong>Prazo</strong><br><%=format(offer.deadline)%></p><p><strong>Status</strong><br><%=offer.status%></p><p><strong>Bairro</strong><br><%=offer.neighborhood%></p></div><p><strong>Conservação:</strong> <%=offer.conservation%></p><p><strong>Validade informada:</strong> <%=offer.expiration_info||'Não informada'%></p><p><strong>Retirada:</strong> <%=offer.pickup_instructions%></p></section>
<h2>Solicitações recebidas</h2><%if(!requests.length){%><div class="empty">Nenhuma solicitação recebida.</div><%}%><%requests.forEach(r=>{%><section class="panel"><h3><%=r.organization_name%></h3><p>Status: <strong><%=r.status%></strong></p><%if(r.status!=='Pendente'||offer.status==='Reservada'){%><p>Contato autorizado: <%=r.responsible%> · <%=r.phone%></p><p>Endereço autorizado: <%=r.address%></p><%}%><%if(r.status==='Pendente'){%><div class="actions"><form method="post" action="/estabelecimento/solicitacoes/<%=r.id%>/confirmar"><input type="hidden" name="csrfToken" value="<%=csrfToken%>"><button class="button">Confirmar</button></form><form method="post" action="/estabelecimento/solicitacoes/<%=r.id%>/rejeitar"><input type="hidden" name="csrfToken" value="<%=csrfToken%>"><input name="reason" placeholder="Motivo da rejeição" required><button class="button secondary">Rejeitar</button></form></div><%}%>
<%if(r.status==='Confirmada'){%><form method="post" action="/estabelecimento/solicitacoes/<%=r.id%>/entrega" class="form-grid"><input type="hidden" name="csrfToken" value="<%=csrfToken%>"><label>Retirada real<input type="datetime-local" name="actualPickupAt" required></label><label>Quantidade efetivamente entregue<input type="number" name="deliveredQuantity" step="0.01" min="0.01" required></label><button class="button">Registrar entrega</button></form><form method="post" action="/estabelecimento/solicitacoes/<%=r.id%>/cancelar"><input type="hidden" name="csrfToken" value="<%=csrfToken%>"><input name="reason" placeholder="Motivo do cancelamento" required><button class="button secondary">Cancelar operação</button></form><%}%></section><%})%></main>
<%- include('../partials/footer') %>
