<%- include('../partials/head',{title:offer?'Editar oferta':'Nova oferta'}) %>
<main class="container narrow"><section class="panel"><h1><%=offer?'Editar oferta':'Nova oferta'%></h1><%if(error){%><p class="error"><%=error%></p><%}%><form method="post" action="<%=offer?'/estabelecimento/ofertas/'+offer.id:'/estabelecimento/ofertas'%>"><input type="hidden" name="csrfToken" value="<%=csrfToken%>">
<label>Nome do alimento<input name="name" value="<%=offer?.name||''%>" required></label><label>Descrição<textarea name="description" required><%=offer?.description||''%></textarea></label><label>Categoria<input name="category" value="<%=offer?.category||''%>" required></label>
<div class="form-grid"><label>Quantidade<input type="number" name="quantity" step="0.01" min="0.01" value="<%=offer?.quantity||''%>" required></label><label>Unidade<select name="unit" required><option value="kg" <%=offer?.unit==='kg'?'selected':''%>>kg</option><option value="litros" <%=offer?.unit==='litros'?'selected':''%>>litros</option><option value="unidades" <%=offer?.unit==='unidades'?'selected':''%>>unidades</option></select></label></div>
<label>Conservação<input name="conservation" value="<%=offer?.conservation||''%>" required></label><label>Validade informada pelo doador<input name="expirationInfo" value="<%=offer?.expiration_info||''%>"></label><label>Prazo limite da retirada (horário de São Paulo)<input type="datetime-local" name="deadline" value="<%=offer?.deadline?offer.deadline.slice(0,16):''%>" required></label>
<label>Cidade<input name="city" value="<%=offer?.city||''%>" required></label><label>Bairro<input name="neighborhood" value="<%=offer?.neighborhood||''%>" required></label><label>Instruções para retirada<textarea name="pickupInstructions" required><%=offer?.pickup_instructions||''%></textarea></label><p class="small">A validade informada é um dado do doador, não uma certificação do sistema.</p><button class="button"><%=offer?'Salvar alterações':'Publicar oferta'%></button></form></section></main>
<%- include('../partials/footer') %>
