<%- include('../partials/head',{title:'Perfil da organização'}) %>
<main class="container narrow"><section class="panel"><h1>Perfil da instituição</h1><%if(error){%><p class="error"><%=error%></p><%}%><form method="post" action="/organizacao/perfil"><input type="hidden" name="csrfToken" value="<%=csrfToken%>"><label>Nome da instituição<input name="institutionName" value="<%=institution.name%>" required></label><div class="form-grid"><label>Cidade<input name="city" value="<%=institution.city%>" required></label><label>Bairro<input name="neighborhood" value="<%=institution.neighborhood%>" required></label></div><label>Endereço<input name="address" value="<%=institution.address%>" required></label><label>Telefone<input name="phone" value="<%=institution.phone%>" required></label><label>Responsável<input name="responsible" value="<%=institution.responsible%>" required></label><label>Tipos aceitos<textarea name="acceptedTypes"><%=institution.accepted_types||''%></textarea></label><label>Capacidade<textarea name="capacity"><%=institution.capacity||''%></textarea></label><label>Transporte<textarea name="transport"><%=institution.transport||''%></textarea></label><label>Armazenamento<textarea name="storage"><%=institution.storage||''%></textarea></label><label>Horários de recebimento<textarea name="receivingHours"><%=institution.receiving_hours||''%></textarea></label><button class="button">Salvar perfil</button></form></section></main>
<%- include('../partials/footer') %>
