<%- include('../partials/head',{title:offer.name}) %>
<main class="container narrow"><section class="panel"><span class="tag"><%=offer.status%></span><h1><%=offer.name%></h1><p><%=offer.description%></p><div class="detail-grid"><p><strong>Quantidade</strong><br><%=offer.quantity%> <%=offer.unit%></p><p><strong>Prazo</strong><br><%=format(offer.deadline)%></p><p><strong>Categoria</strong><br><%=offer.category%></p><p><strong>Localidade</strong><br><%=offer.city%>, <%=offer.neighborhood%></p></div><p><strong>Conservação:</strong> <%=offer.conservation%></p><p><strong>Validade informada:</strong> <%=offer.expiration_info||'Não informada'%></p><p><strong>Retirada:</strong> <%=offer.pickup_instructions%></p><p class="small">Os dados completos de contato e endereço são compartilhados apenas após a confirmação da operação.</p><%if(offer.status==='Disponível'){%><form method="post" action="/organizacao/ofertas/<%=offer.id%>/solicitar"><input type="hidden" name="csrfToken" value="<%=csrfToken%>"><button class="button">Solicitar retirada</button></form><%}%></section></main>
<%- include('../partials/footer') %>
