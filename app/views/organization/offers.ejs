<%- include('../partials/head',{title:'Ofertas disponíveis'}) %>
<main class="container page"><h1>Ofertas</h1><form class="filter-bar" method="get"><label>Cidade<input name="city" value="<%=filters.city||''%>"></label><label>Categoria<input name="category" value="<%=filters.category||''%>"></label><label>Disponibilidade<select name="availability"><option value="">Todas</option><option value="Disponível" <%=filters.availability==='Disponível'?'selected':''%>>Disponível</option><option value="Reservada" <%=filters.availability==='Reservada'?'selected':''%>>Reservada</option><option value="Concluída" <%=filters.availability==='Concluída'?'selected':''%>>Concluída</option></select></label><button class="button">Filtrar</button></form>
<%if(!offers.length){%><div class="empty">Nenhuma oferta corresponde aos filtros.</div><%}else{%><div class="card-list"><%offers.forEach(o=>{%><article class="card"><span class="tag"><%=o.status%></span><h3><%=o.name%></h3><p><%=o.quantity%> <%=o.unit%> · <%=o.category%></p><p><%=o.city%> · <%=o.neighborhood%></p><p><strong>Prazo:</strong> <%=format(o.deadline)%></p><a href="/organizacao/ofertas/<%=o.id%>">Ver detalhes</a></article><%})%></div><%}%></main>
<%- include('../partials/footer') %>
