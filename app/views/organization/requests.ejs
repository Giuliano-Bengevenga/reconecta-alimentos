<%- include('../partials/head',{title:'Minhas solicitações'}) %>
<main class="container page"><h1>Minhas solicitações</h1><%if(!requests.length){%><div class="empty">Você ainda não fez solicitações.</div><%}else{%><div class="table-wrap"><table><thead><tr><th>Oferta</th><th>Estabelecimento</th><th>Status da solicitação</th><th>Prazo</th><th>Ações</th></tr></thead><tbody><%requests.forEach(r=>{%><tr><td><%=r.offer_name%></td><td><%=r.institution_name%></td><td><%=r.status%></td><td><%=format(r.deadline)%></td><td><%if(['Pendente','Confirmada'].includes(r.status)){%><form method="post" action="/organizacao/solicitacoes/<%=r.id%>/cancelar"><input type="hidden" name="csrfToken" value="<%=csrfToken%>"><input name="reason" placeholder="Motivo" required><button class="link-button">Cancelar</button></form><%}%><%if(r.status==='Confirmada'&&r.actual_pickup_at){%><form method="post" action="/organizacao/solicitacoes/<%=r.id%>/recebimento"><input type="hidden" name="csrfToken" value="<%=csrfToken%>"><button class="link-button">Confirmar recebimento</button></form><%}%></td></tr><%})%></tbody></table></div><%}%></main>
<%- include('../partials/footer') %>
